{
  "name": "claude-board",
  "version": "1.0.0",
  "description": "Shared task board + MCP server so a team's AI coding agents (Claude Code, Codex, GitHub Copilot, Gemini CLI or Cursor, or any MCP tool) can work on one repo together",
  "main": "src/server.js",
  "scripts": {
    "preboards": "node scripts/ensure-deps.mjs",
    "boards": "node scripts/boards.mjs",
    "prestart": "node scripts/ensure-deps.mjs",
    "start": "node --watch-path=src --watch-preserve-output src/server.js",
    "pretunnel": "node scripts/ensure-deps.mjs",
    "tunnel": "node scripts/tunnel.mjs",
    "prejoin": "node scripts/ensure-deps.mjs",
    "join": "node scripts/join.mjs",
    "predoctor": "node scripts/ensure-deps.mjs",
    "doctor": "node scripts/doctor.mjs",
    "prerehearse": "node scripts/ensure-deps.mjs",
    "rehearse": "node scripts/rehearse.mjs",
    "predemo": "node scripts/ensure-deps.mjs",
    "demo": "node scripts/demo.mjs",
    "restore": "node scripts/restore.mjs",
    "pretest": "node scripts/ensure-deps.mjs --dev",
    "test": "node tests/run.mjs",
    "build:present": "npm --prefix office install --no-audit --no-fund && npm --prefix office run build:present"
  },
  "type": "module",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "express": "^5.3.0",
    "qrcode": "^1.5.4",
    "zod": "^4.6.7"
  },
  "private": true,
  "engines": {
    "node": ">=22.13"
  },
  "devDependencies": {
    "puppeteer-core": "^25.16.0"
  }
}
